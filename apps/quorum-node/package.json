{
  "name": "@quorum-lab/quorum-node",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "start": "node dist/main.js",
    "dev": "node --watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.0",
    "@grpc/proto-loader": "^0.7.13",
    "@quorum-lab/clocks": "workspace:*",
    "@quorum-lab/consistency": "workspace:*",
    "@quorum-lab/contracts": "workspace:*",
    "@quorum-lab/protocol": "workspace:*",
    "@quorum-lab/replication": "workspace:*",
    "@quorum-lab/storage": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
